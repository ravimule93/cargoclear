{
  "hosting": [
    {
      "site": "cargoclear-app",
      "headers": [
        {
          "source": "/api/proxy/**/stream",
          "headers": [
            { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
            { "key": "X-Accel-Buffering", "value": "no" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "cargoclear-ui",
            "region": "asia-south1"
          }
        }
      ]
    },
    {
      "site": "cargoclear-japac",
      "headers": [
        {
          "source": "/api/proxy/**/stream",
          "headers": [
            { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
            { "key": "X-Accel-Buffering", "value": "no" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "cargoclear-ui",
            "region": "asia-south1"
          }
        }
      ]
    },
