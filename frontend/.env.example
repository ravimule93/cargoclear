# Server-only backend base URL used by the Next.js proxy route. Required in production.
# In local development, defaults to http://localhost:8080 if unset.
# Set ALLOW_LOCALHOST=true to explicitly permit localhost fallback in production tests.
API_BASE=http://localhost:8080

# How the proxy authenticates to the API. Leave unset locally (the API is open on localhost).
# On Cloud Run the API is a PRIVATE service: deploy_ui.sh sets this to "google-id-token", and the proxy then sends
# an ID token of the UI service's identity (which holds roles/run.invoker on the API).
# API_AUTH_MODE=google-id-token

# How many Google-controlled hops append to X-Forwarded-For before this server (used to find the end user's IP for
# the API's rate limits). 1 = Cloud Run's own front end; 2 = behind an external HTTPS load balancer.
# TRUSTED_PROXY_HOPS=1
