# Backend Environment Variables
# Copy this to .env and fill in real values for local development.
# Never commit .env to version control.

# --- GCP Core ---
PROJECT_ID=cargoclear-hackathon
REGION=asia-south1

# --- Release identity ---
# Deployment fails closed unless these are supplied (deploy_api.sh derives them
# from the checked-out Git revision when possible). They are exposed without
# secrets at GET /version to link a hosted result to its source revision.
RELEASE_SHA=local-development
RELEASE_TIMESTAMP=2026-10-16T00:00:00Z

# --- GCS ---
RAW_BUCKET=cargoclear-raw-pdfs

# --- Firestore ---
FIRESTORE_DATABASE=(default)

# --- BigQuery ---
BQ_DATASET=ahtn
BQ_TABLE_TARIFF=master_tariff
BQ_MODEL_EMBEDDING=embedding_model

# One tariff lookup is a BigQuery job run in a worker thread: how long to wait for it, and how many run at once
# for one bundle (identical descriptions are looked up once)
BQ_QUERY_TIMEOUT_SECONDS=30
TARIFF_LOOKUP_CONCURRENCY=4

# --- Gemini Models ---
# Google retires model versions. Check the model lifecycle page BEFORE a deployment (docs/GCP_VERIFICATION.md) and run
# scripts/preflight_gcp.py after changing either value.
GEMINI_LIVE_MODEL=gemini-2.5-flash
GEMINI_LIVE_LOCATION=asia-south1
GEMINI_BATCH_MODEL=gemini-2.5-pro
GEMINI_BATCH_LOCATION=global

# --- Gemini live extraction ---
# Seconds to wait for one Gemini call before giving up on it (the attempt is then retried)
GEMINI_TIMEOUT_SECONDS=120
# Attempts per document for transient failures (429/5xx/timeouts) and unparseable answers
GEMINI_MAX_ATTEMPTS=3
# Documents extracted at the same time
GEMINI_MAX_CONCURRENCY=3
# Output tokens one answer may use, thinking tokens included. An answer that hits it is billed and then thrown away, so a larger value
# is a larger worst case per document (the deploy script uses this default too); raise it only for a document type that needs more.
GEMINI_MAX_OUTPUT_TOKENS=16384
# How much the model may think. The knob depends on the model (measured 2026-10-16, docs/input-gating-audit.md section 13):
#   gemini-2.5-flash  GEMINI_THINKING_BUDGET, in tokens: 0 switches thinking off, a negative value means "do not send the field"
#   gemini-2.5-pro    the same, but it cannot be switched off: a budget below 128 is raised to 128
#   gemini-3.x        refuses GEMINI_THINKING_BUDGET (any value) on a request with an image and takes GEMINI_THINKING_LEVEL instead
GEMINI_THINKING_BUDGET=0
# MINIMAL (no thinking tokens), LOW, MEDIUM, HIGH, or DEFAULT (do not send the field: the model's own default, which spends a few hundred
# thinking tokens on a one-word answer). Used only for gemini-3.x models.
GEMINI_THINKING_LEVEL=MINIMAL
# Refuse a document whose (base64-encoded) request would exceed this many MB / this many pages
GEMINI_MAX_REQUEST_MB=18
GEMINI_MAX_PAGES=30
# Which pages of a document the model reads: page 1 and the pages that look like part of the document (not terms and conditions),
# at most this many per document. The rest are not read and the assessment lists them (check P-001 when content-looking pages were left out).
MAX_PAGES_SENT=10
# Longest PDF accepted at upload, in pages (only MAX_PAGES_SENT of them reach the model). Must be at least MAX_PAGES_SENT.
MAX_PDF_PAGES=100
# Before a file is stored, its first page must be a document the assessment reads. Recognised from the text layer for free;
# otherwise (a scan, or a language the lists do not hold) one small vision request decides (page 1, about 1,900 tokens, one word back).
# Without a model (demo mode) only the text layer can say, and a file it cannot place is accepted. false switches the gate off.
RELEVANCE_GATE=true
# The text layer is the uploader's to write, so a title in it is trusted only when the words that name the document can be SEEN on the
# rendered first page (not white on white, not a speck); a title that IS visible still passes without a model call. true: never accept on the
# text layer, ask the model about every new file (about 1,900 tokens each): the strict setting.
RELEVANCE_VISION_ALWAYS=false
# Reuse the model's answer for a document this bundle already had read with the SAME request (same page images, model, prompt, schema and
# thinking/output settings): an unchanged reassessment, or a bundle that gains one document, asks the model only about what is new. Kept per
# bundle (never shared between bundles); only the model's answer is kept, never a check result or a correction. false: every run asks again.
EXTRACTION_CACHE=true
# Days a kept answer (the extracted text of a document) is used and kept. Each carries expires_at for the Firestore TTL policy
# (infra/firestore/setup_ttl.sh); one past it is never used, even before Firestore deletes it.
EXTRACTION_CACHE_TTL_DAYS=30

# --- Credentials ---
# Recommended on a laptop: run `gcloud auth application-default login` (no variable needed; the ADC file is detected).
# Or point at a service-account key file with an ABSOLUTE path (a relative path or a path that does not exist is
# reported as "no credentials found"). On Cloud Run leave it unset: the service identity is used.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# --- End-user authentication ---
# Live mode accepts only a verified Google Workspace/OpenID Connect ID token
# forwarded by the private UI BFF in X-CargoClear-User-Token. Do not use the
# demo mock session format outside APP_MODE=demo.
AUTH_ENABLED=false
# OAUTH_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://cargoclear-ui-xxxxx-as.a.run.app

# --- Corrections ---
# Most corrections (and undo entries) one bundle's audit chain may hold
MAX_CORRECTIONS_PER_BUNDLE=500

# --- Run dispatch and scaling (docs/GCP_VERIFICATION.md section 9) ---
# local: an assessment runs as a background task of the instance that received it (demo, tests, ONE always-on instance).
# cloudtasks: the API enqueues a Cloud Task per run and a worker request executes it, so the service may scale out and
# scale-in cannot kill a run. Who may run a bundle is a lease in Firestore either way.
RUN_DISPATCH=local
# A queued run nobody picks up within this many seconds is given up (failed as interrupted)
RUN_QUEUE_WAIT_SECONDS=900
# Only with RUN_DISPATCH=cloudtasks (deploy_api.sh sets them):
# TASKS_QUEUE=cargoclear-runs
# TASKS_LOCATION=asia-south1            # default: REGION
# TASKS_SERVICE_ACCOUNT=cargoclear-tasks-sa@PROJECT.iam.gserviceaccount.com   # signs the task's OIDC token; the ONLY caller of the worker endpoint
# INTERNAL_CALLER_EMAIL=                # default: TASKS_SERVICE_ACCOUNT
# API_URL=https://cargoclear-api-xxxx-el.a.run.app   # this service's own URL: the task's target and the token's audience
# TASKS_DISPATCH_DEADLINE_SECONDS=1500  # longer than RUN_TIMEOUT_SECONDS; Cloud Tasks allows at most 1800

# --- Audit signing ---
# After each completed assessment the head of the audit chain is signed with this Cloud KMS key VERSION (an
# EC_SIGN_P256_SHA256 key; infra/kms/setup_signing_key.sh prints the value). Unset: demo mode signs with a throwaway local key
# (labelled "demo key, not KMS"); live mode does not sign and says so. AUDIT_SIGNING=false switches signing off.
# SIGNING_KEY_VERSION=projects/PROJECT/locations/asia-south1/keyRings/cargoclear/cryptoKeys/audit-head/cryptoKeyVersions/1
AUDIT_SIGNING=true

# --- Preprocessing (what the model is shown) ---
# bw: 1-bit pages (the original input). gray: 8-bit grayscale. A/B them with scripts/live_smoke_extraction.py --page-mode
PAGE_IMAGE_MODE=bw
# Straighten a skewed scan (a measured skew between the two limits) and record the reversible transform, so evidence boxes
# still land on the original page. Off until the A/B has shown it helps on the real model.
PREPROCESS_DESKEW=false
DESKEW_MIN_DEGREES=0.3
DESKEW_MAX_DEGREES=10
# Keep the page images the model was shown (GET /bundles/{id}/documents/{doc}/pages/{n}): "what did it see?"
PERSIST_PROCESSED_PAGES=true

# --- Run lifecycle ---
# The API runs as ONE instance. A running analysis touches its run record every RUN_HEARTBEAT_SECONDS; a RUNNING record
# that nobody has touched for RUN_STALE_AFTER_SECONDS (>= 3 x the heartbeat) belongs to a dead process and is marked ERROR.
RUN_HEARTBEAT_SECONDS=10
RUN_STALE_AFTER_SECONDS=90
# Hard deadline for one whole analysis; on expiry the run ends in ERROR ("the analysis exceeded the time limit")
RUN_TIMEOUT_SECONDS=1200

# --- SSE stream ---
# Poll interval while a run is RUNNING/QUEUED, and otherwise
STREAM_POLL_ACTIVE_SECONDS=1.0
STREAM_POLL_IDLE_SECONDS=3.0

# --- Request and upload limits ---
# Largest accepted PDF upload (MB). The request body guard allows this + 1 MB for the multipart envelope.
MAX_UPLOAD_MB=50
# Most pixels one page may take when rendered for the model, in megapixels at 200 DPI (A4 is 3.9, A1 is 31). A larger page is refused
# at upload and again before the render: a page the size of a billboard is a few KB of PDF and gigabytes of pixels.
MAX_PAGE_MEGAPIXELS=50
# Largest accepted JSON request body (KB)
MAX_JSON_BODY_KB=256
# Distinct documents one bundle may hold (re-uploading identical bytes is not counted)
MAX_DOCUMENTS_PER_BUNDLE=20
# Longest accepted bundle `reference` (longer is refused with 422, never truncated)
MAX_REFERENCE_CHARS=200

# --- Abuse and cost control (0 switches a limit off; counted in this process, or in Firestore: see RATE_LIMIT_BACKEND) ---
# Per client address: POST /bundles, POST .../documents, POST /demo/case-c
RATE_LIMIT_WRITES_PER_MINUTE=60
# Per client address: POST .../analyze and .../reassess
RATE_LIMIT_RUNS_PER_MINUTE=10
# Where the two per-minute limits above are counted. memory: in this process (demo mode, one instance). firestore: shared by
# EVERY instance, so a user's limit does not multiply with the number of instances (needs infra/firestore/setup_ttl.sh once;
# if Firestore is unreachable a request is counted in-process instead: degraded, never off)
RATE_LIMIT_BACKEND=memory
# Analyses running at once in THIS process (RUN_DISPATCH=local); one more is refused with 503 SERVICE_BUSY. With
# RUN_DISPATCH=cloudtasks the service-wide cap is the queue's max-concurrent-dispatches (infra/tasks/setup_queue.sh)
MAX_CONCURRENT_RUNS=4
# Model tokens the whole service may spend per UTC day (0 = off). Counted when a run ends and when a relevance check is made; checked when an
# analysis or reassessment starts (429 TOKEN_BUDGET_EXCEEDED, with Retry-After, until 00:00 UTC; a recompute is never refused) and before a
# relevance check asks the model. A placeholder, not a price or a quota: 5,000,000 is about 180 four-document analyses. GET /api/v1/token-budget
# shows it. One counter for the whole service; per-client limits are the per-minute ones above. On Cloud Run, infra/deploy_api.sh REQUIRES the
# number (a live service that was never told one logs daily_token_budget_is_the_default at start).
DAILY_TOKEN_BUDGET=5000000
# Key the rate limits by the first valid IP in X-Forwarded-For instead of the socket peer.
# Only behind a proxy that overwrites the header: the first entry is whatever the client sent.
TRUST_FORWARDED_FOR=false
# Name of a request header that carries the END USER's IP, set by a trusted caller. In the deployment the API is private
# and only the UI's server-side proxy can call it; the proxy sets X-CargoClear-Client-IP, so the limits above are per
# user and not one bucket shared by everybody behind the proxy. Leave UNSET anywhere the header could come from a client.
# CLIENT_IP_HEADER=x-cargoclear-client-ip

# --- API documentation ---
# /docs, /redoc and /openapi.json. Unset = on when APP_MODE=demo, off when APP_MODE=live.
# ENABLE_API_DOCS=false

# --- Pipeline engine ---
# What drives the stage loop. "native" (default) is the plain loop. "adk" runs the same stages as the nodes of a google-adk
# Workflow (an optional SPIKE, see Handoff.md "ADK spike report"); it needs the SEPARATE ADK lock (requirements-adk.txt:
# google-adk pins its own fastapi/starlette) and the server refuses to start if google-adk cannot be imported.
# Anything other than native/adk is a startup error.
PIPELINE_ENGINE=native
